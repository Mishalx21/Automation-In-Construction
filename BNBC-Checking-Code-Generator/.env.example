# ---------------------------------------------------------------------------
# LLM provider: "gemini" | "openrouter"
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini

# Gemini key pool — comma-separated for rotation on quota/rate limits.
# REQUIRED when LLM_PROVIDER=gemini.
GEMINI_API_KEYS=your-key-1,your-key-2

# Model rotation chain. Gemini quota is PER MODEL, so every model here adds
# its own limit to the pool: a rate-limited one is parked for
# GEMINI_MODEL_COOLDOWN_SECONDS and the next takes over.
# Also available on these keys, left out on purpose:
#   gemini-3.1-pro-preview, gemini-2.5-pro   capable but >75s on a trivial call
#   gemini-3.5-flash-lite, gemini-3.1-flash-lite   fast, pass capability probes,
#                                                  but drafting quality unmeasured
GEMINI_MODEL_FALLBACKS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash

GEMINI_MODEL_COOLDOWN_SECONDS=60

# OpenRouter — REQUIRED when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Optional provider pin for OpenRouter routing (fallbacks stay enabled).
OPENROUTER_PROVIDER=

# ---------------------------------------------------------------------------
# Model roles — leave blank to take the active provider's defaults
# (gemini: gemini-3.6-flash / gemini-3.6-flash / gemini-2.5-flash;
#  openrouter: deepseek-v4-pro / deepseek-v4-pro / google/gemini-2.5-flash)
# ---------------------------------------------------------------------------
SPEC_MODEL=
DRAFTER_MODEL=
REVIEWER_MODEL=

# Reasoning-effort caps (none|low|medium|high, "" = provider default).
# Spec stage stays minimal: spec outputs are structured data, not proofs, and
# reasoning runaways burned 18-22K tokens into the completion cap.
DRAFTER_REASONING_EFFORT=medium
SPEC_REASONING_EFFORT=none

# ---------------------------------------------------------------------------
# Budgets / execution
# ---------------------------------------------------------------------------
TOKEN_BUDGET_PER_RULE=500000
TOKEN_ALERT_PER_RULE=300000
CHECKER_TIMEOUT_SECONDS=120
EXEC_MAX_WORKERS=4
LLM_REQUEST_TIMEOUT_SECONDS=600
LLM_WALL_TIMEOUT_SECONDS=900
LLM_MAX_COMPLETION_TOKENS=32768

# ---------------------------------------------------------------------------
# Agent session + loop bounds
# ---------------------------------------------------------------------------
AGENT_MAX_TURNS=24
AGENT_MAX_INSPECTS=10
AGENT_WALL_TIMEOUT_SECONDS=1800
AGENT_CONTEXT_TOKENS=96000
AGENT_INSPECT_STDOUT_CHARS=4000
MAX_SPEC_REVISIONS=1
MAX_PLAN_REGENS=2
ORACLE_FAULT_MISS_RATIO=0.9
ENABLE_CONFORMANCE_REVIEW=false

# ---------------------------------------------------------------------------
# LangSmith tracing (optional)
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=bnbc-rule-checker
# Use https://apac.api.smith.langchain.com for APAC, or leave the US default.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
