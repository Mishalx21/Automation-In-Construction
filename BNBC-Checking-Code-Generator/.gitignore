# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments and secrets
.env
.venv
env/
venv/
ENV/

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Tooling caches
.pytest_cache/

# ---------------------------------------------------------------------------
# Run output (artifacts/)
#
# Tracked, because they ARE the result and its proof:
#   checker.py          the generated checker
#   spec_card.yaml      the interpretation contract; "disk wins" on a re-run
#   acceptance.json     the gate evidence — and what load_accepted() indexes
#   prerequisites.json  the data contract shipped with the checker
#   provenance.json     models, tokens, cost, fixture counts
#
# Ignored, because they are bulk or churn:
# ---------------------------------------------------------------------------

# Fixtures: the .ifc files are ~800 MB, and a manifest without them is useless
# on a fresh clone — the whole set is regenerated from the spec card anyway.
artifacts/fixtures/

# Failure evidence for a human to read locally: full candidate code, rewritten
# on every attempt. Regenerated by the next run.
artifacts/*/rejection.json
artifacts/*/partial/

# Plan-time census/digest caches (keyed on file size+mtime — machine-local)
models/*.census.json
models/*.digest.json
