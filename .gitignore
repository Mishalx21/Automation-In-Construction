# IFC source models and generated fixtures are large binary data assets.
# Keep them outside normal Git history; distribute them via object storage
# or Git LFS only when a repository has sufficient LFS quota.
*.ifc

# Per-job fault-injection outputs are generated at runtime and can be large.
ifc-fault-injector/out/

# macOS Finder metadata — never useful in history.
.DS_Store

# Local AI-tooling/editor config — machine-specific, not part of the project.
.agents/
.aider-desk/
.impeccable/
skills-lock.json
